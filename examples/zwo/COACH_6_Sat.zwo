<workout_file>
  <author>AI coach</author>
  <name>Sat Nov 7 · Z2 + sprint sprinkles 60min @ ~197W</name>
  <description>Z2 with a 10-s acceleration every 8 min. Keeps the legs snappy. Avg ~197 W, cap 220 W outside sprinkles. Follow the on-screen cues. Optional. Rest if you prefer.</description>
  <sportType>bike</sportType>
  <tags><tag name="COACH"/></tags>
