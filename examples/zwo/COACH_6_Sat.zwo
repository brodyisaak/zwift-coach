      <textevent timeoffset="0" message="Cruise Z2, drink"/>
    </SteadyState>
    <SteadyState Duration="10" Power="1.500" Cadence="110">
      <textevent timeoffset="0" message="Sprinkle: 10 s fast, seated, spin it up"/>
    </SteadyState>
